{
  "id": "comfyui.photoshop.plugin",
  "name": "ComfyUI Integration",
  "version": "1.0.0",
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "24.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "comfyui.panel",
      "label": {
        "default": "ComfyUI"
      }
    }
  ],
  "requiredPermissions": [
    "network",
    "allowCodeGenerationFromStrings",
    "launchProcess",
    "webview"
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/icon.png"
    }
  ]
}
